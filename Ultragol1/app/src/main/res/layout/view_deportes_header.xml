<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/glass_search_bg"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">
        <EditText
            android:id="@+id/dsSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Buscar canal deportivo"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E9AA8"
            android:textSize="14sp"
            android:singleLine="true"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:imeOptions="actionSearch"/>
        <TextView
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:text="⌕"
            android:textColor="#DCE5F2"
            android:textSize="26sp"
            android:gravity="center"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="LIGAS Y COMPETICIONES"
        android:textColor="#9EABB9"
        android:textSize="10sp"
        android:fontFamily="sans-serif-bold"
        android:letterSpacing="0.1"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/dsLeagueTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dsTabLive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="CANALES"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/sport_section_chip_active"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/dsTabUpcoming"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="PARTIDOS"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/sport_section_chip_inactive"
            android:clickable="true"
            android:focusable="true"/>
        <TextView
            android:id="@+id/dsTabHighlights"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MOMENTOS"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/sport_section_chip_inactive"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/dsLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:indeterminateTint="#D50000"/>
    <TextView
        android:id="@+id/dsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="No hay contenido disponible"
        android:textColor="#77FFFFFF"
        android:textSize="13sp"
        android:visibility="gone"/>
</LinearLayout>