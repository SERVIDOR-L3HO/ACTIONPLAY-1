<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Inline video player -->
            <FrameLayout android:id="@+id/webviewContainer"
                android:layout_width="match_parent" android:layout_height="212dp"
                android:background="#000000">

                <WebView android:id="@+id/playerWebView"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>

                <!-- Intercepting / loading overlay -->
                <FrameLayout android:id="@+id/interceptingOverlay"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:visibility="visible">

                    <!-- Movie poster / backdrop while stream loads -->
                    <ImageView android:id="@+id/playerPosterBg"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:alpha="0.55"/>

                    <!-- Dark gradient over poster -->
                    <View
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="#88000000"/>

                    <!-- Spinner + label centrado -->
                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="vertical" android:gravity="center">
                        <ProgressBar
                            android:layout_width="32dp" android:layout_height="32dp"
                            android:indeterminateTint="#FF6B35"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Buscando stream…"
                            android:textColor="#CCFFFFFF" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                </FrameLayout>

                <!-- TOP BAR: back + title + fullscreen -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="4dp" android:paddingEnd="4dp"
                    android:background="@drawable/gradient_top_black">

                    <ImageView android:id="@+id/btnPlayerBack"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_back"
                        android:tint="#FFFFFF" android:padding="9dp"
                        android:background="@drawable/back_btn_glass"
                        android:clickable="true" android:focusable="true"/>

                    <TextView android:id="@+id/playerTitle"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="4dp"
                        android:textColor="#FFFFFF" android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" android:maxLines="1"
                        android:ellipsize="end"/>

                    <!-- Stream captured badge -->
                    <TextView android:id="@+id/playerStreamBadge"
                        android:layout_width="wrap_content" android:layout_height="26dp"
                        android:layout_marginEnd="6dp"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:gravity="center"
                        android:text="● STREAM"
                        android:textColor="#FF6B35" android:textSize="10sp"
                        android:fontFamily="sans-serif-bold" android:letterSpacing="0.05"
                        android:background="@drawable/player_stream_badge_glass"
                        android:visibility="gone"/>

                    <!-- Fullscreen toggle -->
                    <ImageView android:id="@+id/btnPlayerFullscreen"
                        android:layout_width="40dp" android:layout_height="40dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_media_fullscreen"
                        android:tint="#FFFFFF" android:padding="9dp"
                        android:background="@drawable/back_btn_glass"
                        android:clickable="true" android:focusable="true"/>
                </LinearLayout>

                <!-- Loading progress bar (webview page load) -->
                <ProgressBar android:id="@+id/playerProgress"
                    android:layout_width="match_parent" android:layout_height="3dp"
                    android:layout_gravity="top" android:layout_marginTop="52dp"
                    android:progressDrawable="@drawable/progress_orange"
                    android:max="100" android:visibility="gone"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>

                <!-- Resize handle at bottom -->
                <LinearLayout android:id="@+id/playerResizeHandle"
                    android:layout_width="match_parent" android:layout_height="28dp"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:clickable="true" android:focusable="true">
                    <View android:layout_width="44dp" android:layout_height="4dp"
                        android:background="@drawable/player_resize_handle"/>
                </LinearLayout>

            </FrameLayout>

            <!-- Detail info panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/player_detail_panel_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="8dp">

                <!-- Type badge (PELÍCULA / SERIE) -->
                <TextView
                    android:id="@+id/pdTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/detail_type_badge_bg"
                    android:text="PELÍCULA"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.06"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"/>

                <TextView
                    android:id="@+id/pdTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.1"/>

                <TextView
                    android:id="@+id/pdMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/player_meta_pill_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"/>

                <!-- Action buttons row: Me gusta / Descargar / Reportar / Compartir -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:id="@+id/pdBtnLike"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/player_action_btn_glass">
                        <TextView android:id="@+id/pdLikeIcon"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="♡" android:textColor="#FFFFFF" android:textSize="18sp"/>
                        <TextView android:id="@+id/pdLikeLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Me gusta" android:textColor="#FFFFFF" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pdBtnDownload"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/player_action_btn_glass">
                        <TextView android:id="@+id/pdDownloadIcon"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⬇" android:textColor="#4FC3F7" android:textSize="18sp"/>
                        <TextView android:id="@+id/pdDownloadLabel"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Descargar" android:textColor="#4FC3F7" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pdBtnCast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/player_action_btn_glass">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_cast_tv"
                            android:tint="#FFFFFF"
                            android:contentDescription="Transmitir a TV"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Transmitir" android:textColor="#FFFFFF" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pdBtnShare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/player_action_btn_glass">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⊞" android:textColor="#FFFFFF" android:textSize="18sp"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Servidores" android:textColor="#FFFFFF" android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- ══ SINOPSIS glass card ══════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/synopsis_glass_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SINOPSIS"
                        android:textColor="#66FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.20"/>

                    <View
                        android:layout_width="22dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="5dp"
                        android:background="#FF6B35"/>

                    <TextView
                        android:id="@+id/pdOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#DDFFFFFF"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.6"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
                <!-- ═══════════════════════════════════════════════════════════ -->
            </LinearLayout>

            <!-- Similar movies -->
            <include android:id="@+id/pdRowSimilar" layout="@layout/row_section"/>

            <View android:layout_width="match_parent" android:layout_height="24dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout android:id="@+id/fullscreenContainer"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:background="#000000"/>
</FrameLayout>
