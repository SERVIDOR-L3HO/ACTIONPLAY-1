<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Backdrop full width -->
    <ImageView
        android:id="@+id/detailBackdrop"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:scaleType="centerCrop"/>

    <!-- Backdrop bottom gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:background="@drawable/gradient_detail_overlay"/>

    <!-- Top bar shadow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/gradient_top_black"/>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Poster area: sits over backdrop -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="290dp">

                <ImageView
                    android:id="@+id/detailPoster"
                    android:layout_width="155dp"
                    android:layout_height="225dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:background="@drawable/poster_glass_bg"
                    android:elevation="6dp"/>

                <!-- "Ver Tráiler" glass button — bottom-center, hidden until trailer is ready -->
                <LinearLayout
                    android:id="@+id/btnTrailer"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/trailer_btn_glass"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:layout_marginEnd="7dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ver Tráiler"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"/>
                </LinearLayout>
            </FrameLayout>

            <!-- Info section — plain black background -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <!-- Type badge + C rating badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/detailTypeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/detail_type_badge_bg"
                        android:text="PELÍCULA"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.06"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>

                    <TextView
                        android:id="@+id/detailBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/badge_rating_pill"
                        android:text="C"
                        android:textColor="#AAFFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"/>
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/detailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.1"/>

                <!-- Meta: year · duration · lang -->
                <TextView
                    android:id="@+id/detailMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#88FFFFFF"
                    android:textSize="13sp"
                    android:letterSpacing="0.02"/>

                <!-- ◆ Rating pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/rating_pill_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◆ "
                        android:textColor="#4FC3F7"
                        android:textSize="12sp"/>
                    <TextView
                        android:id="@+id/detailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"/>
                </LinearLayout>

                <!-- Genre chips row -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none"
                    android:overScrollMode="never">
                    <LinearLayout
                        android:id="@+id/genreChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"/>
                </HorizontalScrollView>

                <!-- ══ SINOPSIS glass card ══════════════════════════════════════════ -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/synopsis_glass_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="16dp">

                        <!-- "SINOPSIS" micro-label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SINOPSIS"
                            android:textColor="#66FFFFFF"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.20"/>

                        <!-- Red accent underline -->
                        <View
                            android:layout_width="22dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="5dp"
                            android:background="#CC1111"/>

                        <!-- Synopsis text -->
                        <TextView
                            android:id="@+id/detailOverview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="#E8FFFFFF"
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.75"
                            android:fontFamily="sans-serif"/>

                    </LinearLayout>
                </FrameLayout>
                <!-- ══════════════════════════════════════════════════════════════ -->

                <!-- ── Favorito compact glass pill ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/btnFavorite"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/btn_fav_glass"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="♡  "
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Favorito"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Hidden — IDs kept for Java compatibility -->
                <LinearLayout
                    android:id="@+id/btnMyList"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="0dp"/>
                    <TextView android:layout_width="0dp" android:layout_height="0dp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/btnDownload"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/downloadIcon"  android:layout_width="0dp" android:layout_height="0dp"/>
                    <TextView android:id="@+id/downloadLabel" android:layout_width="0dp" android:layout_height="0dp"/>
                </LinearLayout>

                <!-- ── REPRODUCIR button — orange + animated ── -->
                <FrameLayout
                    android:id="@+id/btnPlay"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_play_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="4dp">

                    <!-- Shimmer sweep overlay -->
                    <View
                        android:id="@+id/btnPlayShimmer"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/btn_play_shimmer"
                        android:alpha="0"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▶"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:layout_marginEnd="10dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REPRODUCIR"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.07"/>
                    </LinearLayout>
                </FrameLayout>

                <View android:layout_width="match_parent" android:layout_height="8dp"/>
            </LinearLayout>

            <!-- ══ EPISODE SECTION (series/anime/dorama only) ══════════════════ -->
            <LinearLayout
                android:id="@+id/episodeSectionDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#000000"
                android:visibility="gone">

                <!-- Glass tab bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:background="#060606">

                    <TextView
                        android:id="@+id/tabEpisodios"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Episodios"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:paddingEnd="28dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/tabInformacion"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Información"
                        android:textColor="#44FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:paddingEnd="28dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- Tab underline indicator -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#060606">
                    <View
                        android:id="@+id/tabIndicatorEp"
                        android:layout_width="90dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="16dp"
                        android:background="#D50000"/>
                </FrameLayout>

                <!-- Full-width divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#0DFFFFFF"/>

                <!-- Season dropdown pill -->
                <LinearLayout
                    android:id="@+id/seasonSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/ep_season_pill_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tvSeasonPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Temporada 1"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  ▾"
                        android:textColor="#66FFFFFF"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- Episodes tab content -->
                <FrameLayout
                    android:id="@+id/episodeTabContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Loading spinner -->
                    <FrameLayout
                        android:id="@+id/epLoadingFrame"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:visibility="visible">
                        <ProgressBar
                            android:id="@+id/epLoadingDetail"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#4FC3F7"/>
                    </FrameLayout>

                    <!-- Episode cards container (populated programmatically) -->
                    <LinearLayout
                        android:id="@+id/episodeListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- Información tab content (hidden by default) -->
                <LinearLayout
                    android:id="@+id/infoTabContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvInfoOverview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:lineSpacingMultiplier="1.6"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>

            </LinearLayout>
            <!-- ═══════════════════════════════════════════════════════════════ -->

            <!-- Saga/franchise section (movies only, hidden unless the title belongs to one) -->
            <include
                android:id="@+id/rowSaga"
                layout="@layout/row_section"
                android:visibility="gone"/>

            <!-- Related section -->
            <include android:id="@+id/rowRelated" layout="@layout/row_section"/>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ CARGANDO SERVIDORES overlay — solo letras, sin fondo ════════════ -->
    <FrameLayout
        android:id="@+id/loadingServersOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:visibility="gone"
        android:elevation="20dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Solo texto centrado, sin tarjeta -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Spinner oculto (mantenemos ID por compatibilidad Java) -->
            <ProgressBar
                android:id="@+id/loadingSpinner"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>

            <!-- "CARGANDO" -->
            <TextView
                android:id="@+id/tvLoadingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARGANDO"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.35"
                android:layout_marginBottom="4dp"/>

            <!-- "SERVIDORES" — protagonista -->
            <TextView
                android:id="@+id/tvLoadingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVIDORES"
                android:textColor="#FFD50000"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.08"/>

            <!-- IDs fantasmas para compatibilidad con el código Java existente -->
            <TextView android:id="@+id/loadingDot1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/loadingDot2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/loadingDot3" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

        </LinearLayout>
    </FrameLayout>
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Back button — LAST so it renders on top of scroll content -->
    <FrameLayout
        android:id="@+id/btnDetailBack"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_margin="16dp"
        android:background="@drawable/back_btn_glass"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>
    </FrameLayout>
</FrameLayout>
