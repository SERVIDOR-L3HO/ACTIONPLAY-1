<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- ── TopBar ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/bg_primary">

        <!-- Logo -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/logo_ultragol"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="Action Play"/>

        <!-- Íconos derecha -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#FFFFFF"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:id="@+id/btnSurprise"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="🎲"
                android:textSize="19sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="No sé qué ver"/>
            <ImageView
                android:id="@+id/btnBell"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_notification"
                android:tint="#FFFFFF"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Notificaciones"/>
            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:text="☰"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Profile avatar mini -->
            <FrameLayout
                android:id="@+id/btnProfile"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivProfileMini"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/avatar_g1"/>
                <TextView
                    android:id="@+id/tvProfileInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:background="@drawable/profile_avatar_circle"
                    android:visibility="gone"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ── Hero Banner ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="520dp">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/heroBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:id="@+id/bannerDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center"/>
    </FrameLayout>

    <!-- ── Continuar viendo ── -->
    <LinearLayout
        android:id="@+id/sectionContinueWatching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="#D50000"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CONTINUAR VIENDO"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"/>
        </LinearLayout>

        <!-- Horizontal scroll of cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContinueWatching"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>
    </LinearLayout>

    <!-- ── Rows ── -->
    <!-- ── Canales en vivo (TV) ── -->
    <include android:id="@+id/rowTvLive" layout="@layout/row_tv_live"/>

    <include android:id="@+id/rowNew"          layout="@layout/row_section"/>
    <include android:id="@+id/rowShortsdramas" layout="@layout/row_section"/>

    <!-- ── EN VIVO Glass Carousel (between Últimos Estrenos and Películas Populares) ── -->
    <include android:id="@+id/rowLiveGlass" layout="@layout/row_live_glass"/>

    <!-- ── Sagas Completas (en medio del feed) ── -->
    <include android:id="@+id/rowSagas" layout="@layout/row_section"/>

    <include android:id="@+id/rowMovies"   layout="@layout/row_section"/>
    <include android:id="@+id/rowSeries"   layout="@layout/row_section"/>
    <include android:id="@+id/rowAnime"    layout="@layout/row_section"/>
    <include android:id="@+id/rowDoramas"  layout="@layout/row_section"/>
    <include android:id="@+id/rowTop10"    layout="@layout/row_section"/>

    <!-- ── Explorar Todo section title (the grid itself is a real RecyclerView tail,
         not nested here, so its items are properly recycled while scrolling) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="28dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="@color/red_primary"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EXPLORAR TODO"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:textAllCaps="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="∞"
                android:textColor="#D50000"
                android:textSize="20sp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="14dp"
            android:text="Desliza hacia abajo para descubrir más"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif"/>
    </LinearLayout>
</LinearLayout>
