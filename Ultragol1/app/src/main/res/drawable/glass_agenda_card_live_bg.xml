<?xml version="1.0" encoding="utf-8"?>
<!-- Same frosted-glass card, with a warm glowing edge for matches in progress. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#26FF6A3D"
                android:centerColor="#16FFFFFF"
                android:endColor="#0AFFFFFF"
                android:angle="270"/>
            <stroke android:width="1.4dp" android:color="#66FF5A36"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:topLeftRadius="19dp" android:topRightRadius="19dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
</layer-list>
