<?xml version="1.0" encoding="utf-8"?>
<!-- Professional frosted-glass card for the sports agenda list: translucent
     gradient fill + soft border + a top sheen layer simulating glass. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22FFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#0AFFFFFF"
                android:angle="270"/>
            <stroke android:width="1dp" android:color="#2AFFFFFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#28FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:topLeftRadius="19dp" android:topRightRadius="19dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
</layer-list>
