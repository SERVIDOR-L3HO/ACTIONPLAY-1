<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#CC5500" android:endColor="#8B1200" android:angle="90"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF6A3D" android:centerColor="#E5342B" android:endColor="#B71C1C" android:angle="90"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
