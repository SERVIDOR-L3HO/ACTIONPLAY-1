<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF"/>
            <stroke android:width="1dp" android:color="#40FFFFFF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#1EFFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#08FFFFFF"
                        android:angle="270"/>
                    <stroke android:width="1dp" android:color="#26FFFFFF"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#22FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="270"/>
                    <corners android:topLeftRadius="13dp" android:topRightRadius="13dp"
                        android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
