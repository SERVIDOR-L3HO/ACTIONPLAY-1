<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1CFFFFFF"
                android:endColor="#0DFFFFFF"
                android:angle="270"/>
            <stroke android:width="1dp" android:color="#22FFFFFF"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:topLeftRadius="13dp" android:topRightRadius="13dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp"/>
        </shape>
    </item>
</layer-list>
